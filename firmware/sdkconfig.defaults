# Common defaults for all boards.
CONFIG_IDF_TARGET="esp32s3"

# Partition table: two OTA slots, see docs/adr/0005-partition-layout.md.
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA rollback (CLAUDE.md §3.8): a new image stays "pending verify" until the
# application marks it valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Optimise for size: the app image budget is 1.70 MB (CLAUDE.md §4.3).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Core dump to flash for post-mortem analysis (CLAUDE.md §3.11).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 80 MHz is enough for BLE + USB + a small web server, and runs noticeably cooler (the chip temperature is on the System page);
# raise to 160 only if profiling demands it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y


# Web server: WebSocket support for /api/v1/ws, more sockets (HTTP + DNS + WebSocket clients).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# USB: TinyUSB owns the native USB PHY (M2), so the USB Serial/JTAG console is unavailable. Logs go to the
# RAM log buffer shown in the web app; there is no CDC interface in release builds (CLAUDE.md §3.2).
# Interface 0 = boot keyboard, interface 1 = mouse + consumer + system.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_TINYUSB_HID_COUNT=3

# BLE: NimBLE as central only, up to 4 HID peripherals + 1 pairing candidate (CLAUDE.md §3.3).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4

# Signed OTA images (M6, ADR 6). Hardware secure boot stays OFF: only the app verifies the signature when an update is
# written (esp_ota_end), which stops spoofed updates but is not protection against physical access. The signing key
# path is injected by firmware/CMakeLists.txt (HUBBLE_SIGNING_KEY).
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y

# HTTPS for "check for updates" (certificate bundle with the common root CAs).
# TLS needs about 45 KB for its buffers and handshake; with Wi-Fi, Bluetooth and USB running only about 46-52 KB of
# internal RAM is free (largest block about 31 KB), so GitHub connections failed at random. Keep them in PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# The full Mozilla list: the common subset lacks the USERTrust/Sectigo roots that github.com and api.github.com use,
# which made every HTTPS request to GitHub fail the certificate check.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=n

# 1 ms scheduler tick: the HID report task retries every millisecond (with the default 100 Hz tick that delay rounds
# down to zero and the task would spin), and all millisecond timeouts get their real resolution.
CONFIG_FREERTOS_HZ=1000
# The NimBLE host task runs the GATT callbacks, the report decoding and the USB hand-off; 4 KB was tight.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
