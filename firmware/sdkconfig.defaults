# Common defaults for all boards.
CONFIG_IDF_TARGET="esp32s3"

# Partition table: two OTA slots, see docs/adr/0005-partition-layout.md.
CONFIG_PARTITION_TABLE_CUSTOM=y

# OTA rollback (CLAUDE.md §3.8): a new image stays "pending verify" until the
# application marks it valid.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Optimise for size: the app image budget is 1.70 MB (CLAUDE.md §4.3).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Core dump to flash for post-mortem analysis (CLAUDE.md §3.11).
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# 160 MHz is plenty and saves power; raise only if profiling demands it.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y


# Web server: WebSocket support for /api/v1/ws, more sockets (HTTP + DNS + WebSocket clients).
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16

# USB: TinyUSB owns the native USB PHY (M2), so the USB Serial/JTAG console is unavailable. Logs go to the
# RAM log buffer shown in the web app; there is no CDC interface in release builds (CLAUDE.md §3.2).
# Interface 0 = boot keyboard, interface 1 = mouse + consumer + system.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_TINYUSB_HID_COUNT=2

# BLE: NimBLE as central only, up to 4 HID peripherals + 1 pairing candidate (CLAUDE.md §3.3).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_WHITELIST_SIZE=4
