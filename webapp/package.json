{
  "name": "hubble-webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HubBLE web app (served by the dongle)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "size": "node ../tools/check-webapp-size.mjs dist 150",
    "docs": "typedoc",
    "screenshots": "playwright test --config playwright.screens.config.ts"
  },
  "dependencies": {
    "preact": "^11.2.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.10.0",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
